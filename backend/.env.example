NODE_ENV=development
PORT=4000

# Replace with the connection URL for your PostgreSQL database.
DATABASE_URL=postgres://app_user:change-me@localhost:5432/mydb

# Replace with a unique random value of at least 32 characters.
COOKIE_SECRET=replace-this-with-a-random-secret-at-least-32-characters

APP_ORIGIN=http://localhost:3000

# Replace these with credentials from your SMTP email provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=Practice Login <no-reply@example.com>
